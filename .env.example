# 首次使用时复制为 .env，已有配置不要覆盖；真实密钥不得提交。
# 主入口自动读取当前工作目录的 .env，已有环境变量优先（包括空值）。
PAPER_AGENT_ENV=production
PAPER_AGENT_DATA_DIR=./data
PAPER_AGENT_MAX_CONCURRENCY=4
PAPER_AGENT_REQUEST_TIMEOUT_SECONDS=30

# 第二组排序：可选 embedding 预排序和 CrossEncoder 最终重排。
# embedding 推荐使用多语言向量模型；reranker 使用单输出 CrossEncoder。
PAPER_AGENT_EMBEDDING_MODEL=
PAPER_AGENT_RERANKER_MODEL=
PAPER_AGENT_RERANKER_LOCAL_ONLY=1

# 查询规划使用 PAPER_AGENT_LLM_API_KEY。
# 单篇总结和综述优先使用 OPENAI_API_KEY，缺失时复用查询规划 Key。
# 两者均未配置时使用启发式查询规划 / 抽取式总结和模板报告。
PAPER_AGENT_LLM_API_KEY=
OPENAI_API_KEY=
# 查询规划和总结共用下面的 OpenAI-compatible 地址及模型。
PAPER_AGENT_LLM_BASE_URL=https://api.openai.com/v1
PAPER_AGENT_LLM_MODEL=gpt-4o-mini
PAPER_AGENT_LLM_TIMEOUT_SECONDS=120
# DeepSeek 示例；使用时替换上面两项，并分别填写需要启用的 Key。
# PAPER_AGENT_LLM_BASE_URL=https://api.deepseek.com
# PAPER_AGENT_LLM_MODEL=deepseek-flash
# PAPER_AGENT_REQUEST_TIMEOUT_SECONDS=180

# 检索与合法开放获取定位：已有链接/arXiv 失败后，依次尝试 Unpaywall、OpenAlex、落地页。
# arXiv 公开 PDF 下载不需要账号或 API Key。
SEMANTIC_SCHOLAR_API_KEY=
PAPER_AGENT_CONTACT_EMAIL=
# Unpaywall 不需要账号或 Key，但必须填写真实联系邮箱；留空会跳过该渠道。
UNPAYWALL_EMAIL=
# OpenAlex 基础调用可匿名；批量检索建议注册免费账号并验证邮箱后获取 Key。
# https://openalex.org/signup → https://openalex.org/settings/api-key
# Key 同时供元数据检索和全文定位使用，只发送到 OpenAlex API，不进入日志。
OPENALEX_API_KEY=

# 第三组下载、解析配置；auto 在有 MinerU Key 时启用 MinerU，否则用 pypdf。
PAPER_AGENT_DOWNLOAD_TIMEOUT_SECONDS=60
PAPER_AGENT_PDF_MAX_BYTES=30000000
PAPER_AGENT_DOWNLOAD_RETRY_LIMIT=2
PAPER_AGENT_DOWNLOAD_MAX_REDIRECTS=5
PAPER_AGENT_MARKDOWN_BACKEND=auto
MINERU_API_KEY=
