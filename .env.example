# Real components may use these variables. Never commit actual keys.
# Copy this file to .env (gitignored); build_agent() loads it at startup.
OPENAI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# LLM-assisted query planning (Chinese idea -> English keywords).
# Any OpenAI-compatible endpoint works (DeepSeek, Ollama /v1, vLLM, ...).
# Unset API key = fully offline heuristic planner.
PAPER_AGENT_LLM_API_KEY=
PAPER_AGENT_LLM_BASE_URL=https://api.deepseek.com
PAPER_AGENT_LLM_MODEL=deepseek-chat

PAPER_AGENT_DATA_DIR=./data
PAPER_AGENT_ENV=retrieval
PAPER_AGENT_MAX_CONCURRENCY=4
PAPER_AGENT_REQUEST_TIMEOUT_SECONDS=30
