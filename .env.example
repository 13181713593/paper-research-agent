# Real components may use these variables. Never commit actual keys.
OPENAI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=
PAPER_AGENT_DATA_DIR=./data
PAPER_AGENT_ENV=demo
PAPER_AGENT_MAX_CONCURRENCY=4
PAPER_AGENT_REQUEST_TIMEOUT_SECONDS=30

# Group 3: download / parse / summarize / report
# PAPER_AGENT_ENV=production enables the real group 3 adapters.
PAPER_AGENT_DOWNLOAD_TIMEOUT_SECONDS=60
PAPER_AGENT_PDF_MAX_BYTES=30000000
PAPER_AGENT_DOWNLOAD_RETRY_LIMIT=2
PAPER_AGENT_DOWNLOAD_MAX_REDIRECTS=5
# auto = MinerU when MINERU_API_KEY is set, otherwise local pypdf; or force pypdf/mineru.
PAPER_AGENT_MARKDOWN_BACKEND=auto
MINERU_API_KEY=
PAPER_AGENT_LLM_BASE_URL=https://api.openai.com/v1
PAPER_AGENT_LLM_MODEL=gpt-4o-mini

# DeepSeek 使用同一个 OPENAI_API_KEY 变量，但应改成自己的 DeepSeek Key，切勿提交。
# PAPER_AGENT_LLM_BASE_URL=https://api.deepseek.com
# PAPER_AGENT_LLM_MODEL=deepseek-flash
# PAPER_AGENT_REQUEST_TIMEOUT_SECONDS=180
# .env 不会自动加载；在项目根目录显式加载后启动：
# python -m dotenv -f .env run -- python -m streamlit run src/paper_agent/ui/app.py
